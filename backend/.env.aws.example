# Bật provider AWS thật sau khi đã tạo đủ tài nguyên.
AWS_ENABLED=true

# Thông tin không bí mật
AWS_REGION=eu-north-1
AWS_DYNAMODB_TABLE_NAME=polly-voice-history
AWS_S3_MEDIA_BUCKET=replace-with-private-media-bucket
AWS_S3_PRESIGNED_URL_TTL_SECONDS=900
AWS_COGNITO_USER_POOL_ID=eu-north-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_COGNITO_ISSUER_URI=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_xxxxxxxxx
AWS_TRANSCRIBE_LANGUAGE_CODE=en-US

# Domain sau khi deploy
PUBLIC_BASE_URL=https://api.example.com
ALLOWED_ORIGINS=https://app.example.com

# Không đặt AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ở đây khi chạy production.
# Production phải dùng IAM Role gắn với Lambda/ECS/App Runner.
